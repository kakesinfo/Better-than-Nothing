#version 450

// Ground-Truth Ambient Occlusion (GTAO - Jimenez et al., 2016)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float sunAngularRadius;

    vec3 lightColor;
    float sunIlluminanceLux;

    vec3 cameraPosition;
    float cameraExposure;

    uint pointLightsCount;
    uint frameIndex;
    uint screenWidth;
    uint screenHeight;

    uint debugView;
    uint toneMapMode;
    uint flags;
    float taaBlendFactor;

    float skyLuminanceNits;
    float atmosphereAltitudeKm;
    float atmosphereMieAnisotropy;
    float atmosphereMultiScatteringFactor;

    float atmosphereDensityScale;
    float aoRadius;
    float aoPower;
    float irradianceIntensity;
} globalUniforms;

layout(set = 1, binding = 0) uniform sampler2D depthTex;
layout(set = 1, binding = 1) uniform sampler2D gbufferNormalTex;
layout(set = 1, binding = 2, rg16f) uniform writeonly image2D outAORaw;
layout(set = 1, binding = 3) uniform sampler2D blueNoiseTex;

const float PI = 3.14159265359;
const float HALF_PI = 1.57079632679;

vec3 DecodeOctahedral(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

vec3 ReconstructViewPos(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = globalUniforms.invViewProj * clipPos;
    worldPos /= worldPos.w;
    return (globalUniforms.view * worldPos).xyz;
}

vec2 SampleBlueNoise2D(ivec2 pixel, uint frame) {
    float b1 = texelFetch(blueNoiseTex, pixel & 63, 0).r;
    float b2 = texelFetch(blueNoiseTex, (pixel + ivec2(19, 37)) & 63, 0).r;
    float t = float(frame & 63u);
    return vec2(
        fract(b1 + t * 0.7548776662466927),
        fract(b2 + t * 0.5698402909980532)
    );
}

float IntegrateArc(float h1, float h2, float n) {
    float cosN = cos(n);
    float sinN = sin(n);
    return 0.25 * ((-cos(2.0 * h1 - n) + cosN + 2.0 * h1 * sinN) +
                   (-cos(2.0 * h2 - n) + cosN + 2.0 * h2 * sinN));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(globalUniforms.screenWidth, globalUniforms.screenHeight);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 texelSize = 1.0 / vec2(size);
    vec2 uv = (vec2(pixel) + 0.5) * texelSize;
    float depth = textureLod(depthTex, uv, 0.0).r;
    if (depth >= 1.0) {
        imageStore(outAORaw, pixel, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    vec3 viewPos = ReconstructViewPos(uv, depth);
    vec3 worldNormal = DecodeOctahedral(textureLod(gbufferNormalTex, uv, 0.0).rg);
    vec3 viewNormal = normalize(mat3(globalUniforms.view) * worldNormal);
    vec3 viewDir = normalize(-viewPos);

    float radius = max(globalUniforms.aoRadius, 0.05);
    float viewDist = max(-viewPos.z, 0.1);
    float projScale = abs(globalUniforms.proj[1][1]) * float(size.y) * 0.5;
    float screenRadius = clamp(radius * projScale / viewDist, 4.0, 96.0);

    vec2 blueXi = SampleBlueNoise2D(pixel, globalUniforms.frameIndex);
    float noiseAngle = blueXi.x * PI;
    float noiseStep = blueXi.y;

    const int SLICES = 3;
    const int STEPS = 4;
    float visibility = 0.0;

    for (int s = 0; s < SLICES; ++s) {
        float phi = noiseAngle + (float(s) / float(SLICES)) * PI;
        vec2 omega = vec2(cos(phi), sin(phi));

        // Project normal onto the slice plane
        vec3 sliceDir = vec3(omega.x, -omega.y, 0.0); // Vulkan screen Y is down
        vec3 orthoDir = sliceDir - dot(sliceDir, viewDir) * viewDir;
        vec3 axis = normalize(cross(orthoDir, viewDir));
        vec3 projNormal = viewNormal - axis * dot(viewNormal, axis);
        float projNormalLen = length(projNormal);
        if (projNormalLen < 1e-5) {
            visibility += 1.0;
            continue;
        }

        float cosN = clamp(dot(projNormal, viewDir) / projNormalLen, -1.0, 1.0);
        float signN = sign(dot(orthoDir, projNormal));
        float nAngle = signN * acos(cosN);

        float maxCosH1 = -1.0;
        float maxCosH2 = -1.0;

        for (int stepIdx = 0; stepIdx < STEPS; ++stepIdx) {
            float stepFrac = (float(stepIdx) + noiseStep) / float(STEPS);
            float offsetPx = max(1.0, stepFrac * stepFrac * screenRadius);
            vec2 offsetUV = omega * offsetPx * texelSize;

            // Positive direction
            vec2 uv1 = uv + offsetUV;
            if (uv1.x >= 0.0 && uv1.x <= 1.0 && uv1.y >= 0.0 && uv1.y <= 1.0) {
                float d1 = textureLod(depthTex, uv1, 0.0).r;
                if (d1 < 1.0) {
                    vec3 sPos = ReconstructViewPos(uv1, d1);
                    vec3 delta = sPos - viewPos;
                    float dist = length(delta);
                    float falloff = clamp(1.0 - (dist / radius) * (dist / radius), 0.0, 1.0);
                    float cosH = dot(delta / max(dist, 1e-5), viewDir);
                    maxCosH1 = max(maxCosH1, mix(-1.0, cosH, falloff));
                }
            }

            // Negative direction
            vec2 uv2 = uv - offsetUV;
            if (uv2.x >= 0.0 && uv2.x <= 1.0 && uv2.y >= 0.0 && uv2.y <= 1.0) {
                float d2 = textureLod(depthTex, uv2, 0.0).r;
                if (d2 < 1.0) {
                    vec3 sPos = ReconstructViewPos(uv2, d2);
                    vec3 delta = sPos - viewPos;
                    float dist = length(delta);
                    float falloff = clamp(1.0 - (dist / radius) * (dist / radius), 0.0, 1.0);
                    float cosH = dot(delta / max(dist, 1e-5), viewDir);
                    maxCosH2 = max(maxCosH2, mix(-1.0, cosH, falloff));
                }
            }
        }

        float h1 = nAngle + max(-acos(clamp(maxCosH2, -1.0, 1.0)) - nAngle, -HALF_PI);
        float h2 = nAngle + min( acos(clamp(maxCosH1, -1.0, 1.0)) - nAngle,  HALF_PI);

        visibility += projNormalLen * IntegrateArc(h1, h2, nAngle);
    }

    float ao = clamp(visibility / float(SLICES), 0.0, 1.0);
    ao = pow(ao, max(globalUniforms.aoPower, 0.1));
    imageStore(outAORaw, pixel, vec4(ao, 0.0, 0.0, 0.0));
}
