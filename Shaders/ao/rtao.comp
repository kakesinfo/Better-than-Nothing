#version 460
#extension GL_EXT_ray_query : require

// Hardware Ray-Traced Ambient Occlusion (RTAO) via VK_KHR_ray_query

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float sunAngularRadius;

    vec3 lightColor;
    float sunIlluminanceLux;

    vec3 cameraPosition;
    float cameraExposure;

    uint pointLightsCount;
    uint frameIndex;
    uint screenWidth;
    uint screenHeight;

    uint debugView;
    uint toneMapMode;
    uint flags;
    float taaBlendFactor;

    float skyLuminanceNits;
    float atmosphereAltitudeKm;
    float atmosphereMieAnisotropy;
    float atmosphereMultiScatteringFactor;

    float atmosphereDensityScale;
    float aoRadius;
    float aoPower;
    float irradianceIntensity;
} globalUniforms;

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 1, binding = 1) uniform sampler2D depthTex;
layout(set = 1, binding = 2) uniform sampler2D gbufferNormalTex;
layout(set = 1, binding = 3, rg16f) uniform writeonly image2D outAORaw;

const float PI = 3.14159265359;

vec3 DecodeOctahedral(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

vec3 ReconstructWorldPos(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = globalUniforms.invViewProj * clipPos;
    return worldPos.xyz / worldPos.w;
}

uint PcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float Rand01(inout uint seed) {
    seed = PcgHash(seed);
    return float(seed) * (1.0 / 4294967296.0);
}

void BuildOrthonormalBasis(vec3 n, out vec3 tangent, out vec3 bitangent) {
    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(up, n));
    bitangent = cross(n, tangent);
}

vec3 SampleCosineHemisphere(float u1, float u2, vec3 N) {
    float r = sqrt(u1);
    float theta = 2.0 * PI * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(1.0 - u1, 0.0));
    vec3 T, B;
    BuildOrthonormalBasis(N, T, B);
    return normalize(T * x + B * y + N * z);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(globalUniforms.screenWidth) || pixel.y >= int(globalUniforms.screenHeight))
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(globalUniforms.screenWidth, globalUniforms.screenHeight);
    float depth = textureLod(depthTex, uv, 0.0).r;
    if (depth >= 1.0) {
        imageStore(outAORaw, pixel, vec4(1.0, 1.0, 0.0, 0.0));
        return;
    }

    vec3 worldPos = ReconstructWorldPos(uv, depth);
    vec3 N = DecodeOctahedral(textureLod(gbufferNormalTex, uv, 0.0).rg);

    float distToCam = length(globalUniforms.cameraPosition - worldPos);
    if (distToCam > 85.0) {
        imageStore(outAORaw, pixel, vec4(1.0, 1.0, 0.0, 0.0));
        return;
    }

    float bias = 0.005 + 0.0012 * distToCam;
    vec3 origin = worldPos + N * bias;

    float radius = max(globalUniforms.aoRadius, 0.05);
    uint seed = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + (globalUniforms.frameIndex & 255u) * 26699u;

    // 1 ray per pixel + spatio-temporal bilateral denoiser (cuts RT load by 50%)
    const int RAY_COUNT = 1;
    float visibilitySum = 0.0;

    for (int i = 0; i < RAY_COUNT; ++i) {
        float u1 = (float(i) + Rand01(seed)) / float(RAY_COUNT);
        float u2 = Rand01(seed);
        vec3 rayDir = SampleCosineHemisphere(u1, u2, N);

        rayQueryEXT rq;
        rayQueryInitializeEXT(
            rq,
            topLevelAS,
            gl_RayFlagsOpaqueEXT,
            0xFF,
            origin,
            0.002,
            rayDir,
            radius
        );
        while (rayQueryProceedEXT(rq)) {}

        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            visibilitySum += 1.0;
        } else {
            // Smooth distance falloff so distant hits contribute less occlusion
            float tHit = rayQueryGetIntersectionTEXT(rq, true);
            float normDist = clamp(tHit / radius, 0.0, 1.0);
            visibilitySum += normDist * normDist;
        }
    }

    float ao = clamp(visibilitySum / float(RAY_COUNT), 0.0, 1.0);
    ao = pow(ao, max(globalUniforms.aoPower, 0.1));
    imageStore(outAORaw, pixel, vec4(ao, 1.0, 0.0, 0.0));
}
