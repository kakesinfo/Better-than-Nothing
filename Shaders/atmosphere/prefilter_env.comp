#version 450

// Dynamic GGX Prefiltered Specular Environment Atlas (128 x 320 = 5 stacked 128 x 64 roughness bands)
// Importance-samples the live Hillaire Sky-View LUT (+ ground bounce) for roughness = 0.0, 0.25, 0.5, 0.75, 1.0.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float sunAngularRadius;

    vec3 lightColor;
    float sunIlluminanceLux;

    vec3 cameraPosition;
    float cameraExposure;

    uint pointLightsCount;
    uint frameIndex;
    uint screenWidth;
    uint screenHeight;

    uint debugView;
    uint toneMapMode;
    uint flags;
    float taaBlendFactor;

    float skyLuminanceNits;
    float atmosphereAltitudeKm;
    float atmosphereMieAnisotropy;
    float atmosphereMultiScatteringFactor;

    float atmosphereDensityScale;
    float aoRadius;
    float aoPower;
    float irradianceIntensity;
} globalUniforms;

layout(set = 1, binding = 0) uniform sampler2D skyViewLUT;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D outPrefilteredEnvLUT;

const float PI = 3.14159265359;
const int ROUGHNESS_BANDS = 5;
const int BAND_HEIGHT = 64;

vec2 DirectionToSkyViewUV(vec3 dir) {
    float azimuth = atan(dir.z, dir.x);
    float u = azimuth / (2.0 * PI) + 0.5;
    float elevation = asin(clamp(dir.y, -1.0, 1.0));
    float v = 0.5 + 0.5 * sign(elevation) * sqrt(abs(elevation) / (PI * 0.5));
    return vec2(u, clamp(v, 0.001, 0.999));
}

vec3 SampleSkyWithGroundBounce(vec3 dir, vec3 zenithNits) {
    if (dir.y >= 0.0) {
        return textureLod(skyViewLUT, DirectionToSkyViewUV(dir), 0.0).rgb;
    }
    vec3 horizonNits = textureLod(skyViewLUT, DirectionToSkyViewUV(normalize(vec3(dir.x, 0.02, dir.z))), 0.0).rgb;
    vec3 groundBounce = mix(horizonNits, zenithNits, 0.5) * vec3(0.28, 0.25, 0.22);
    return mix(horizonNits, groundBounce, smoothstep(0.0, -0.25, dir.y));
}

float RadicalInverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), RadicalInverse_VdC(i));
}

vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness) {
    float a = roughness * roughness;
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / max(1.0 + (a * a - 1.0) * Xi.y, 1e-6));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));

    vec3 H = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outPrefilteredEnvLUT);
    if (coord.x >= size.x || coord.y >= size.y)
        return;

    int bandIdx = coord.y / BAND_HEIGHT;
    int localY = coord.y - bandIdx * BAND_HEIGHT;
    float roughness = float(bandIdx) / float(ROUGHNESS_BANDS - 1);

    vec2 uv = vec2((float(coord.x) + 0.5) / float(size.x), (float(localY) + 0.5) / float(BAND_HEIGHT));
    float azimuth = (uv.x - 0.5) * 2.0 * PI;
    float elevation = (uv.y - 0.5) * PI;

    vec3 N = normalize(vec3(
        cos(elevation) * cos(azimuth),
        sin(elevation),
        cos(elevation) * sin(azimuth)
    ));
    vec3 V = N;

    vec3 zenithNits = textureLod(skyViewLUT, DirectionToSkyViewUV(vec3(0.0, 1.0, 0.0)), 0.0).rgb;

    if (roughness < 0.01) {
        vec3 direct = SampleSkyWithGroundBounce(N, zenithNits);
        imageStore(outPrefilteredEnvLUT, coord, vec4(min(direct, vec3(65000.0)), 1.0));
        return;
    }

    const uint SAMPLE_COUNT = 64u;
    vec3 prefilteredColor = vec3(0.0);
    float totalWeight = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec2 Xi = Hammersley(i, SAMPLE_COUNT);
        vec3 H = ImportanceSampleGGX(Xi, N, roughness);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL > 0.0) {
            prefilteredColor += SampleSkyWithGroundBounce(L, zenithNits) * NdotL;
            totalWeight += NdotL;
        }
    }

    prefilteredColor /= max(totalWeight, 1e-5);
    imageStore(outPrefilteredEnvLUT, coord, vec4(min(prefilteredColor, vec3(65000.0)), 1.0));
}
