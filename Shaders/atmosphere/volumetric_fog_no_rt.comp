#version 450

// Fallback Volumetric Raymarched Fog with Blue Noise (without HW Ray Query), restricted to Sponza AABB

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float sunAngularRadius;

    vec3 lightColor;
    float sunIlluminanceLux;

    vec3 cameraPosition;
    float cameraExposure;

    uint pointLightsCount;
    uint frameIndex;
    uint screenWidth;
    uint screenHeight;

    uint debugView;
    uint toneMapMode;
    uint flags;
    float taaBlendFactor;

    float skyLuminanceNits;
    float atmosphereAltitudeKm;
    float atmosphereMieAnisotropy;
    float atmosphereMultiScatteringFactor;

    float atmosphereDensityScale;
    float aoRadius;
    float aoPower;
    float irradianceIntensity;

    float time;
    float waterLevel;
    float waterWaveScale;
    float waterFoamIntensity;
} globalUniforms;

layout(set = 1, binding = 0) uniform sampler2D depthTex;
layout(set = 1, binding = 1) uniform sampler2D blueNoiseTex;
layout(set = 1, binding = 2) uniform sampler2D transmittanceLUT;
layout(set = 1, binding = 3) uniform sampler2D irradianceLUT;
layout(set = 1, binding = 4, rgba16f) uniform image2D hdrColorImg;

layout(push_constant) uniform VolumetricFogPushConstants {
    float density;
    float heightFalloff;
    float baseHeight;
    float maxDistance;

    float anisotropy;
    float noiseStrength;
    uint  stepCount;
    uint  flags;

    vec4  boxMin;
    vec4  boxMax;
} fogParams;

const float PI = 3.14159265359;
const float GOLDEN_RATIO = 0.61803398875;
const float GROUND_RADIUS_KM = 6360.0;
const float ATMOSPHERE_RADIUS_KM = 6460.0;
const uint FOG_FLAG_BLUE_NOISE = 1u << 0;
const uint FOG_FLAG_RESTRICT_BOX = 1u << 2;

float SafeSqrt(float x) {
    return sqrt(max(x, 0.0));
}

float DistanceToTopAtmosphereBoundary(float r, float mu) {
    float discriminant = r * r * (mu * mu - 1.0) + ATMOSPHERE_RADIUS_KM * ATMOSPHERE_RADIUS_KM;
    return max(0.0, -r * mu + SafeSqrt(discriminant));
}

vec2 TransmittanceUV(float r, float mu) {
    float H = SafeSqrt(ATMOSPHERE_RADIUS_KM * ATMOSPHERE_RADIUS_KM - GROUND_RADIUS_KM * GROUND_RADIUS_KM);
    float rho = SafeSqrt(r * r - GROUND_RADIUS_KM * GROUND_RADIUS_KM);
    float d = DistanceToTopAtmosphereBoundary(r, mu);
    float d_min = ATMOSPHERE_RADIUS_KM - r;
    float d_max = rho + H;
    return clamp(vec2((d - d_min) / max(d_max - d_min, 1e-6), rho / H), vec2(0.0), vec2(1.0));
}

vec2 DirectionToEquirectUV(vec3 dir) {
    float azimuth = atan(dir.z, dir.x);
    float u = azimuth / (2.0 * PI) + 0.5;
    float elevation = asin(clamp(dir.y, -1.0, 1.0));
    float v = elevation / PI + 0.5;
    return vec2(u, clamp(v, 0.015, 0.985));
}

vec2 IntersectAABB(vec3 ro, vec3 rd, vec3 bMin, vec3 bMax) {
    vec3 safeRd = mix(rd, vec3(1e-6), lessThan(abs(rd), vec3(1e-6)));
    vec3 invDir = 1.0 / safeRd;
    vec3 t0 = (bMin - ro) * invDir;
    vec3 t1 = (bMax - ro) * invDir;
    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);
    float tEnter = max(max(tMin.x, tMin.y), tMin.z);
    float tExit = min(min(tMax.x, tMax.y), tMax.z);
    return vec2(tEnter, tExit);
}

float HenyeyGreenstein(float cosTheta, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denom * sqrt(denom));
}

float Hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float ValueNoise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = Hash31(i + vec3(0, 0, 0));
    float n100 = Hash31(i + vec3(1, 0, 0));
    float n010 = Hash31(i + vec3(0, 1, 0));
    float n110 = Hash31(i + vec3(1, 1, 0));
    float n001 = Hash31(i + vec3(0, 0, 1));
    float n101 = Hash31(i + vec3(1, 0, 1));
    float n011 = Hash31(i + vec3(0, 1, 1));
    float n111 = Hash31(i + vec3(1, 1, 1));

    return mix(
        mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
        mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y),
        f.z
    );
}

float SampleFogDensity(vec3 pos, float t, bool restrictBox) {
    float boxFade = 1.0;
    if (restrictBox) {
        vec3 distFromEdge = min(pos - fogParams.boxMin.xyz, fogParams.boxMax.xyz - pos);
        float minEdge = min(min(distFromEdge.x, distFromEdge.z), distFromEdge.y);
        if (minEdge <= 0.0)
            return 0.0;
        boxFade = smoothstep(0.0, max(fogParams.boxMin.w, 0.1), minEdge);
    }

    float heightAboveBase = max(pos.y - fogParams.baseHeight, 0.0);
    float heightDensity = exp(-heightAboveBase * fogParams.heightFalloff);
    if (heightDensity * boxFade < 0.002)
        return 0.0;

    float noiseMod = 1.0;
    if (fogParams.noiseStrength > 0.001) {
        vec3 wind = vec3(t * 0.25, t * 0.03, t * 0.15);
        vec3 p = pos * 0.12 + wind;
        float n = ValueNoise3D(p) * 0.65 + ValueNoise3D(p * 2.1 - wind * 0.4) * 0.35;
        noiseMod = mix(1.0, smoothstep(0.18, 0.88, n) * 1.45, fogParams.noiseStrength);
    }

    return fogParams.density * heightDensity * boxFade * noiseMod;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(globalUniforms.screenWidth) || pixel.y >= int(globalUniforms.screenHeight))
        return;

    if (globalUniforms.debugView != 0u && globalUniforms.debugView != 11u)
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(globalUniforms.screenWidth, globalUniforms.screenHeight);
    vec4 farClip = vec4(uv * 2.0 - 1.0, 0.9999, 1.0);
    vec4 farWorld = globalUniforms.invViewProj * farClip;
    vec3 rayDir = normalize(farWorld.xyz / farWorld.w - globalUniforms.cameraPosition);

    bool restrictBox = (fogParams.flags & FOG_FLAG_RESTRICT_BOX) != 0u;
    float tStart = 0.0;
    float tEnd = fogParams.maxDistance;

    if (restrictBox) {
        vec2 boxHit = IntersectAABB(globalUniforms.cameraPosition, rayDir, fogParams.boxMin.xyz, fogParams.boxMax.xyz);
        tStart = max(boxHit.x, 0.0);
        tEnd = min(boxHit.y, tStart + fogParams.maxDistance);
        if (tEnd <= tStart + 0.02) {
            if (globalUniforms.debugView == 11u)
                imageStore(hdrColorImg, pixel, vec4(0.0, 0.0, 0.0, 1.0));
            return;
        }
    }

    float depth = textureLod(depthTex, uv, 0.0).r;
    float sceneDist = 1e6;
    if (depth < 0.99999) {
        vec4 hitClip = vec4(uv * 2.0 - 1.0, depth, 1.0);
        vec4 hitWorld = globalUniforms.invViewProj * hitClip;
        sceneDist = length(hitWorld.xyz / hitWorld.w - globalUniforms.cameraPosition);
    }

    tEnd = min(tEnd, sceneDist);
    float marchLen = tEnd - tStart;
    if (marchLen <= 0.05) {
        if (globalUniforms.debugView == 11u)
            imageStore(hdrColorImg, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    uint steps = clamp(fogParams.stepCount, 8u, 48u);
    float stepSize = marchLen / float(steps);

    float jitter = 0.5;
    if ((fogParams.flags & FOG_FLAG_BLUE_NOISE) != 0u) {
        float bn = texelFetch(blueNoiseTex, pixel & 63, 0).r;
        jitter = fract(bn + float(globalUniforms.frameIndex & 63u) * GOLDEN_RATIO);
    }

    vec3 sunDir = normalize(-globalUniforms.lightDirection);
    float cosTheta = dot(rayDir, sunDir);
    float phase = mix(HenyeyGreenstein(cosTheta, -0.2), HenyeyGreenstein(cosTheta, clamp(fogParams.anisotropy, 0.0, 0.92)), 0.78);

    float camAltKm = max(globalUniforms.atmosphereAltitudeKm + max(globalUniforms.cameraPosition.y * 0.001, 0.0), 0.005);
    float camR = min(GROUND_RADIUS_KM + camAltKm, ATMOSPHERE_RADIUS_KM - 0.05);
    float sunHorizonFade = smoothstep(-0.04, 0.02, sunDir.y);
    vec3 sunTrans = textureLod(transmittanceLUT, TransmittanceUV(camR, sunDir.y), 0.0).rgb * sunHorizonFade;
    vec3 sunIlluminanceLux = globalUniforms.lightColor * globalUniforms.sunIlluminanceLux * sunTrans;

    vec3 ambientSkyLux = textureLod(irradianceLUT, DirectionToEquirectUV(vec3(0.0, 1.0, 0.0)), 0.0).rgb * globalUniforms.irradianceIntensity;
    vec3 ambientScatterBase = (ambientSkyLux / (4.0 * PI)) * 0.45;
    vec3 fogAlbedo = vec3(0.88, 0.91, 0.96);

    vec3 inScatterNits = vec3(0.0);
    float transmittance = 1.0;

    float t = tStart + jitter * stepSize;
    for (uint i = 0u; i < steps; ++i) {
        vec3 samplePos = globalUniforms.cameraPosition + rayDir * t;
        float sigmaT = SampleFogDensity(samplePos, globalUniforms.time, restrictBox);

        if (sigmaT > 1e-5) {
            vec3 S = fogAlbedo * (sunIlluminanceLux * phase + ambientScatterBase) * sigmaT;
            float stepTrans = exp(-sigmaT * stepSize);
            inScatterNits += transmittance * (S - S * stepTrans) / max(sigmaT, 1e-5);
            transmittance *= stepTrans;
            if (transmittance < 0.01)
                break;
        }

        t += stepSize;
    }

    vec3 inScatterPreExposed = clamp(inScatterNits * globalUniforms.cameraExposure, vec3(0.0), vec3(65000.0));
    if (globalUniforms.debugView == 11u) {
        vec3 dbg = inScatterPreExposed / (inScatterPreExposed + vec3(1.0));
        imageStore(hdrColorImg, pixel, vec4(dbg, 1.0));
        return;
    }

    vec4 sceneHdr = imageLoad(hdrColorImg, pixel);
    vec3 finalHdr = clamp(sceneHdr.rgb * transmittance + inScatterPreExposed, vec3(0.0), vec3(65000.0));
    imageStore(hdrColorImg, pixel, vec4(finalHdr, sceneHdr.a));
}
