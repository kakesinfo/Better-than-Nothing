#version 460

layout(local_size_x = 8, local_size_y = 4, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 projection;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float lightIntensity;

    vec3 lightColor;
    float cameraExposure;

    vec3 cameraPosition;
    uint pointLightCount;

    float screenWidth;
    float screenHeight;
    uint frameIndex;
    uint debugView;

    uint toneMapMode;
    uint flags;
    float elapsedTime;
    float deltaTime;
} globalUniforms;

layout(set = 1, binding = 0) uniform sampler2D shadowRawTex;
layout(set = 1, binding = 1) uniform sampler2D depthTex;
layout(set = 1, binding = 2) uniform sampler2D prevDepthTex;
layout(set = 1, binding = 3) uniform sampler2D gbufferNormalTex;
layout(set = 1, binding = 4) uniform sampler2D prevNormalTex;
layout(set = 1, binding = 5) uniform sampler2D gbufferMotionTex;
layout(set = 1, binding = 6) uniform sampler2D prevMomentsTex;

layout(set = 1, binding = 7, rgba16f) writeonly uniform image2D outMoments;
layout(set = 1, binding = 8, rg16f) writeonly uniform image2D outShadowPing;

layout(std430, set = 1, binding = 9) readonly buffer TileMaskBuffer {
    uint tileMasks[];
};

layout(std430, set = 1, binding = 10) writeonly buffer TileMetaBuffer {
    uint tileMeta[]; // 0 = all shadowed, 1 = all lit, 2 = mixed penumbra
};

shared uint s_allLit;
shared uint s_allShadowed;

float LinearizeDepth(float d)
{
    const float nearP = 0.1;
    const float farP = 1000.0;
    return (nearP * farP) / max(farP - d * (farP - nearP), 1e-5);
}

vec3 DecodeOctahedral(vec2 e)
{
    vec3 v = vec3(e.xy, 1.0 - abs(e.x) - abs(e.y));
    if (v.z < 0.0)
    {
        vec2 s = vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
        v.xy = (1.0 - abs(v.yx)) * s;
    }
    return normalize(v);
}

// FFX 3x5 tile bitmask spatial mean & variance
vec2 ComputeBitmaskSpatialMoments(ivec2 pixel, uint tilesX, uint tilesY)
{
    int centerTileX = pixel.x / 8;
    int centerTileY = pixel.y / 4;

    float litCount = 0.0;
    float totalCount = 0.0;

    for (int dy = -1; dy <= 1; ++dy)
    {
        int ty = centerTileY + dy;
        if (ty < 0 || ty >= int(tilesY))
            continue;
        for (int dx = -1; dx <= 1; ++dx)
        {
            int tx = centerTileX + dx;
            if (tx < 0 || tx >= int(tilesX))
                continue;
            uint mask = tileMasks[uint(ty) * tilesX + uint(tx)];
            litCount += float(bitCount(mask));
            totalCount += 32.0;
        }
    }

    float mean = litCount / max(totalCount, 1.0);
    float variance = max(mean * (1.0 - mean), 0.0);
    return vec2(mean, variance);
}

void main()
{
    if (gl_LocalInvocationIndex == 0u)
    {
        s_allLit = 1u;
        s_allShadowed = 1u;
    }
    barrier();

    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = ivec2(int(globalUniforms.screenWidth), int(globalUniforms.screenHeight));
    uint tilesX = (uint(screenSize.x) + 7u) / 8u;
    uint tilesY = (uint(screenSize.y) + 3u) / 4u;

    if (pixelCoord.x < screenSize.x && pixelCoord.y < screenSize.y)
    {
        float depth = texelFetch(depthTex, pixelCoord, 0).r;
        if (depth >= 1.0)
        {
            imageStore(outMoments, pixelCoord, vec4(1.0, 1.0, 1.0, 0.0));
            imageStore(outShadowPing, pixelCoord, vec4(1.0, 0.0, 0.0, 0.0));
            atomicAnd(s_allShadowed, 0u);
        }
        else
        {
            vec2 rawSample = texelFetch(shadowRawTex, pixelCoord, 0).rg;
            float currentShadow = rawSample.r;
            float currentHitDist = rawSample.g;

            vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(screenSize);
            vec2 motion = texelFetch(gbufferMotionTex, pixelCoord, 0).rg;
            vec2 prevUv = uv - motion;
            vec3 normal = DecodeOctahedral(texelFetch(gbufferNormalTex, pixelCoord, 0).rg);

            vec2 spatialMoments = ComputeBitmaskSpatialMoments(pixelCoord, tilesX, tilesY);
            float spatialMean = spatialMoments.x;
            float spatialVar = spatialMoments.y;
            float spatialStd = sqrt(spatialVar);

            bool sunMoved = (globalUniforms.flags & 32u) != 0u;
            bool validHistory = (!sunMoved && prevUv.x >= 0.0 && prevUv.x <= 1.0 && prevUv.y >= 0.0 && prevUv.y <= 1.0 && globalUniforms.frameIndex > 0u);
            vec4 prevMoments = vec4(0.0);

            if (validHistory)
            {
                float prevDepth = textureLod(prevDepthTex, prevUv, 0.0).r;
                vec3 prevNormal = DecodeOctahedral(textureLod(prevNormalTex, prevUv, 0.0).rg);

                float linCurr = LinearizeDepth(depth);
                float linPrev = LinearizeDepth(prevDepth);
                float relDepthDiff = abs(linCurr - linPrev) / max(linCurr, 0.1);
                float normalDot = dot(normal, prevNormal);

                if (prevDepth >= 1.0 || relDepthDiff > 0.08 || normalDot < 0.92)
                    validHistory = false;
                else
                    prevMoments = textureLod(prevMomentsTex, prevUv, 0.0);
            }

            float historyLen = validHistory ? min(prevMoments.b + 1.0, 8.0) : 1.0;
            float alpha = max(1.0 / historyLen, 0.15);

            // Clamp temporal history tightly to spatial neighborhood envelope to prevent ghosting
            float clampedPrev = clamp(prevMoments.r, spatialMean - 1.15 * spatialStd, spatialMean + 1.15 * spatialStd);
            float mean = validHistory ? mix(clampedPrev, currentShadow, alpha) : currentShadow;
            float moment2 = validHistory ? mix(prevMoments.g, currentShadow * currentShadow, alpha) : (currentShadow * currentShadow);
            float temporalVar = max(0.0, moment2 - mean * mean);
            float variance = (historyLen < 4.0) ? max(spatialVar, temporalVar) : max(temporalVar, spatialVar * 0.25);

            float hitDist = validHistory ? mix(prevMoments.a, currentHitDist, alpha) : currentHitDist;

            imageStore(outMoments, pixelCoord, vec4(mean, moment2, historyLen, hitDist));
            imageStore(outShadowPing, pixelCoord, vec4(mean, variance, 0.0, 0.0));

            if (mean < 0.999 || variance > 1e-4)
                atomicAnd(s_allLit, 0u);
            if (mean > 0.001 || variance > 1e-4)
                atomicAnd(s_allShadowed, 0u);
        }
    }

    barrier();

    if (gl_LocalInvocationIndex == 0u)
    {
        uint tileIdx = gl_WorkGroupID.y * tilesX + gl_WorkGroupID.x;
        if (s_allShadowed != 0u)
            tileMeta[tileIdx] = 0u;
        else if (s_allLit != 0u)
            tileMeta[tileIdx] = 1u;
        else
            tileMeta[tileIdx] = 2u;
    }
}
