#version 460

layout(local_size_x = 8, local_size_y = 4, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 projection;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float lightIntensity;

    vec3 lightColor;
    float cameraExposure;

    vec3 cameraPosition;
    uint pointLightCount;

    float screenWidth;
    float screenHeight;
    uint frameIndex;
    uint debugView;

    uint toneMapMode;
    uint flags;
    float elapsedTime;
    float deltaTime;
} globalUniforms;

layout(set = 1, binding = 0) uniform sampler2D shadowInTex;
layout(set = 1, binding = 1) uniform sampler2D depthTex;
layout(set = 1, binding = 2) uniform sampler2D gbufferNormalTex;
layout(set = 1, binding = 3, rg16f) writeonly uniform image2D outShadowFiltered;
layout(std430, set = 1, binding = 4) readonly buffer TileMetaBuffer {
    uint tileMeta[]; // 0 = all shadowed, 1 = all lit, 2 = mixed penumbra
};

layout(push_constant) uniform FilterPushConstants {
    int stepSize;
} pc;

vec3 DecodeOctahedral(vec2 e)
{
    vec3 v = vec3(e.xy, 1.0 - abs(e.x) - abs(e.y));
    if (v.z < 0.0)
    {
        vec2 s = vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
        v.xy = (1.0 - abs(v.yx)) * s;
    }
    return normalize(v);
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = ivec2(int(globalUniforms.screenWidth), int(globalUniforms.screenHeight));

    if (pixelCoord.x >= screenSize.x || pixelCoord.y >= screenSize.y)
        return;

    uint tilesX = (uint(screenSize.x) + 7u) / 8u;
    uint tilesY = (uint(screenSize.y) + 3u) / 4u;
    int tileX = int(gl_WorkGroupID.x);
    int tileY = int(gl_WorkGroupID.y);
    uint centerMeta = tileMeta[uint(tileY) * tilesX + uint(tileX)];

    // Only early-out when the entire 3x3 tile neighborhood is homogeneous so A-Trous never creates 8x4 tile seams
    if (centerMeta != 2u)
    {
        bool neighborhoodUniform = true;
        for (int ty = -1; ty <= 1 && neighborhoodUniform; ++ty)
        {
            int ny = clamp(tileY + ty, 0, int(tilesY) - 1);
            for (int tx = -1; tx <= 1; ++tx)
            {
                int nx = clamp(tileX + tx, 0, int(tilesX) - 1);
                if (tileMeta[uint(ny) * tilesX + uint(nx)] != centerMeta)
                {
                    neighborhoodUniform = false;
                    break;
                }
            }
        }
        if (neighborhoodUniform)
        {
            float v = (centerMeta == 1u) ? 1.0 : 0.0;
            imageStore(outShadowFiltered, pixelCoord, vec4(v, 0.0, 0.0, 0.0));
            return;
        }
    }

    float centerDepth = texelFetch(depthTex, pixelCoord, 0).r;
    if (centerDepth >= 1.0)
    {
        imageStore(outShadowFiltered, pixelCoord, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    vec2 centerVal = texelFetch(shadowInTex, pixelCoord, 0).rg;
    float centerShadow = centerVal.r;
    vec3 centerNormal = DecodeOctahedral(texelFetch(gbufferNormalTex, pixelCoord, 0).rg);

    // 3x3 smoothed variance estimate (FFX variance-guided edge stopping)
    float filteredVar = 0.0;
    const float varKernel[3] = float[3](0.25, 0.5, 0.25);
    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            ivec2 p = clamp(pixelCoord + ivec2(dx, dy), ivec2(0), screenSize - 1);
            filteredVar += texelFetch(shadowInTex, p, 0).g * varKernel[dx + 1] * varKernel[dy + 1];
        }
    }

    float sigmaShadow = 4.0 * sqrt(max(filteredVar, 0.0)) + 0.02;
    float phiDepth = max(centerDepth * 0.015, 1e-4);

    // 3x3 A-Trous wavelet filter with stride = pc.stepSize (1, 2, 4)
    const float kernel[3] = float[3](0.25, 0.5, 0.25);
    float sumShadow = centerShadow;
    float sumVar = centerVal.g;
    float sumWeight = 1.0;

    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            if (dx == 0 && dy == 0)
                continue;

            ivec2 q = pixelCoord + ivec2(dx, dy) * pc.stepSize;
            if (q.x < 0 || q.y < 0 || q.x >= screenSize.x || q.y >= screenSize.y)
                continue;

            float qDepth = texelFetch(depthTex, q, 0).r;
            if (qDepth >= 1.0)
                continue;

            vec2 qVal = texelFetch(shadowInTex, q, 0).rg;
            vec3 qNormal = DecodeOctahedral(texelFetch(gbufferNormalTex, q, 0).rg);

            float wDepth = exp(-abs(centerDepth - qDepth) / phiDepth);
            float wNormal = pow(max(0.0, dot(centerNormal, qNormal)), 16.0);
            float wShadow = exp(-abs(centerShadow - qVal.r) / sigmaShadow);
            float wSpatial = kernel[dx + 1] * kernel[dy + 1];

            float w = wSpatial * wDepth * wNormal * wShadow;
            sumShadow += qVal.r * w;
            sumVar += qVal.g * w * w;
            sumWeight += w;
        }
    }

    float outShadow = clamp(sumShadow / max(sumWeight, 1e-5), 0.0, 1.0);
    float outVar = max(sumVar / max(sumWeight * sumWeight, 1e-5), 0.0);

    imageStore(outShadowFiltered, pixelCoord, vec4(outShadow, outVar, 0.0, 0.0));
}
