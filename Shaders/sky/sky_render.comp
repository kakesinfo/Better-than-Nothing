#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 projection;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float lightIntensity;

    vec3 lightColor;
    float cameraExposure;

    vec3 cameraPosition;
    uint pointLightCount;

    float screenWidth;
    float screenHeight;
    uint frameIndex;
    uint debugView;

    uint toneMapMode;
    uint flags;
    float elapsedTime;
    float deltaTime;

    float irradianceIntensity;
    float waterWaveScale;
    float waterFoamIntensity;
    float grassWindStrength;

    float grassWindSpeed;
    float grassFadeDistance;
    float cloudDensity;
    float cloudShadowStrength;
} globalUniforms;

layout(set = 1, binding = 0) uniform sampler2D depthTex;
layout(set = 1, binding = 1) uniform sampler2D skyViewLUT;
layout(set = 1, binding = 2) uniform sampler2D transmittanceLUT;
layout(set = 1, binding = 3, rgba16f) writeonly uniform image2D outHdrColor;

layout(push_constant) uniform SkyRenderPushConstants {
    float skyLuminanceNits;
    float cloudCoverage;
    float cloudSpeed;
    uint enableClouds;
} pc;

const float PI = 3.14159265359;
const float PLANET_RADIUS_KM = 6360.0;
const float ATMOSPHERE_RADIUS_KM = 6460.0;
const float CLOUD_BOTTOM_M = 1350.0;
const float CLOUD_TOP_M = 3450.0;
const float CLOUD_THICKNESS_M = CLOUD_TOP_M - CLOUD_BOTTOM_M;

vec2 DirToSkyViewUV(vec3 dir)
{
    float viewHeight = PLANET_RADIUS_KM + max(globalUniforms.cameraPosition.y * 0.001, 0.001);
    float vHorizon = sqrt(max(0.0, viewHeight * viewHeight - PLANET_RADIUS_KM * PLANET_RADIUS_KM));
    float cosBeta = vHorizon / viewHeight;
    float beta = acos(clamp(cosBeta, -1.0, 1.0));
    float zenithHorizonAngle = PI - beta;

    float viewZenithAngle = acos(clamp(dir.y, -1.0, 1.0));
    float v = 0.0;
    if (viewZenithAngle < zenithHorizonAngle)
    {
        float coord = 1.0 - viewZenithAngle / max(zenithHorizonAngle, 1e-5);
        v = 0.5 * (1.0 - sqrt(max(0.0, coord)));
    }
    else
    {
        float coord = (viewZenithAngle - zenithHorizonAngle) / max(beta, 1e-5);
        v = 0.5 + 0.5 * sqrt(max(0.0, coord));
    }

    float azimuth = atan(dir.z, dir.x);
    float u = azimuth / (2.0 * PI) + 0.5;
    return vec2(u, clamp(v, 0.0, 1.0));
}

vec2 LutTransmittanceParamsToUv(float viewHeight, float viewZenithCosAngle)
{
    float H = sqrt(max(0.0, ATMOSPHERE_RADIUS_KM * ATMOSPHERE_RADIUS_KM - PLANET_RADIUS_KM * PLANET_RADIUS_KM));
    float rho = sqrt(max(0.0, viewHeight * viewHeight - PLANET_RADIUS_KM * PLANET_RADIUS_KM));
    float disc = viewHeight * viewHeight * (viewZenithCosAngle * viewZenithCosAngle - 1.0) + ATMOSPHERE_RADIUS_KM * ATMOSPHERE_RADIUS_KM;
    float d = max(0.0, (-viewHeight * viewZenithCosAngle + sqrt(max(0.0, disc))));
    float dMin = ATMOSPHERE_RADIUS_KM - viewHeight;
    float dMax = rho + H;
    float xMu = (d - dMin) / max(dMax - dMin, 1e-5);
    float xR = rho / max(H, 1e-5);
    return vec2(clamp(xMu, 0.0, 1.0), clamp(xR, 0.0, 1.0));
}

// Interleaved Gradient Noise + temporal animation (converges smoothly with TAA)
float InterleavedGradientNoise(ivec2 pixel, uint frameIdx)
{
    vec2 p = vec2(pixel) + float(frameIdx & 63u) * vec2(5.588238, 3.852941);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float Hash31(vec3 p)
{
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float ValueNoise3D(vec3 x)
{
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);

    return mix(
        mix(mix(Hash31(i + vec3(0, 0, 0)), Hash31(i + vec3(1, 0, 0)), f.x),
            mix(Hash31(i + vec3(0, 1, 0)), Hash31(i + vec3(1, 1, 0)), f.x), f.y),
        mix(mix(Hash31(i + vec3(0, 0, 1)), Hash31(i + vec3(1, 0, 1)), f.x),
            mix(Hash31(i + vec3(0, 1, 1)), Hash31(i + vec3(1, 1, 1)), f.x), f.y),
        f.z
    );
}

float HenyeyGreenstein(float cosTheta, float g)
{
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denom * sqrt(denom));
}

// Nubis-style 3D volumetric cumulus density (matching test/full-pass)
float SampleCloudDensity(vec3 worldPosM, out float outHeightFrac)
{
    float hFrac = (worldPosM.y - CLOUD_BOTTOM_M) / CLOUD_THICKNESS_M;
    outHeightFrac = clamp(hFrac, 0.0, 1.0);
    if (hFrac <= 0.0 || hFrac >= 1.0)
        return 0.0;

    float heightProfile = smoothstep(0.0, 0.18, hFrac) * smoothstep(1.0, 0.58, hFrac);
    if (heightProfile <= 0.001)
        return 0.0;

    vec3 wind = vec3(0.82, 0.0, 0.57) * (globalUniforms.elapsedTime * pc.cloudSpeed * 3.5);
    vec3 p = (worldPosM + wind) * 0.00034;

    float n0 = ValueNoise3D(p);
    float n1 = ValueNoise3D(p * 2.07 + vec3(13.7, 5.1, 9.3));
    float baseShape = n0 * 0.65 + n1 * 0.35;

    float coverageThreshold = 1.0 - clamp(pc.cloudCoverage, 0.0, 0.95);
    float baseCloud = smoothstep(coverageThreshold, min(coverageThreshold + 0.36, 0.99), baseShape) * heightProfile;
    if (baseCloud <= 0.002)
        return 0.0;

    float n2 = ValueNoise3D(p * 4.35 - wind * 0.00018);
    float n3 = ValueNoise3D(p * 9.10 + vec3(3.1, 17.4, 11.8));
    float billow = (1.0 - abs(n2 * 2.0 - 1.0)) * 0.65 + n3 * 0.35;

    float eroded = clamp(baseCloud - (1.0 - billow) * 0.28 * (1.0 - baseCloud * 0.6), 0.0, 1.0);
    return eroded * max(globalUniforms.cloudDensity, 0.0) * 0.0028;
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = ivec2(int(globalUniforms.screenWidth), int(globalUniforms.screenHeight));
    if (pixelCoord.x >= screenSize.x || pixelCoord.y >= screenSize.y)
        return;

    if (globalUniforms.debugView != 0u)
        return;

    float depth = texelFetch(depthTex, pixelCoord, 0).r;
    if (depth < 1.0)
        return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(screenSize);
    vec4 farClip = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec4 farWorld = globalUniforms.invViewProj * farClip;
    vec3 worldPos = farWorld.xyz / farWorld.w;
    vec3 rd = normalize(worldPos - globalUniforms.cameraPosition);
    vec3 sunDir = normalize(-globalUniforms.lightDirection);

    vec3 skyDir = normalize(vec3(rd.x, max(rd.y, 0.002), rd.z));
    vec3 skyColor = textureLod(skyViewLUT, DirToSkyViewUV(skyDir), 0.0).rgb;
    if (rd.y < 0.0)
    {
        float belowHorizon = smoothstep(0.0, -0.25, rd.y);
        skyColor = mix(skyColor, skyColor * 0.35, belowHorizon);
    }

    float viewHeight = PLANET_RADIUS_KM + max(globalUniforms.cameraPosition.y * 0.001, 0.001);
    float sunHorizonFade = smoothstep(-0.04, 0.02, sunDir.y);
    vec3 sunTrans = textureLod(transmittanceLUT, LutTransmittanceParamsToUv(viewHeight, sunDir.y), 0.0).rgb * sunHorizonFade;

    // Physical solar disk with limb-darkening
    float cosTheta = dot(rd, sunDir);
    float sunAngularRadius = 0.0093;
    float cosSunEdge = cos(sunAngularRadius);
    if (cosTheta > cos(sunAngularRadius * 1.15))
    {
        float diskEdge = smoothstep(cos(sunAngularRadius * 1.15), cosSunEdge, cosTheta);
        float centerFactor = clamp((cosTheta - cosSunEdge) / max(1.0 - cosSunEdge, 1e-6), 0.0, 1.0);
        float limb = mix(0.45, 1.0, pow(centerFactor, 0.4));
        float solidAngle = 2.0 * PI * (1.0 - cosSunEdge);
        skyColor += (globalUniforms.lightColor * globalUniforms.lightIntensity / max(solidAngle, 1e-5)) * sunTrans * diskEdge * limb;
    }

    // Raymarched Volumetric Cumulus Clouds (Nubis Beer-Powder + IGN jitter)
    if (pc.enableClouds != 0u && rd.y > 0.015 && pc.cloudCoverage > 0.01)
    {
        float ry = max(rd.y, 0.035);
        float tEnter = max((CLOUD_BOTTOM_M - globalUniforms.cameraPosition.y) / ry, 0.0);
        float tExit = (CLOUD_TOP_M - globalUniforms.cameraPosition.y) / ry;
        float marchLen = min(tExit - tEnter, 16000.0);

        if (marchLen > 10.0 && tEnter < 38000.0)
        {
            const int CLOUD_STEPS = 14;
            float stepSize = marchLen / float(CLOUD_STEPS);
            float jitter = InterleavedGradientNoise(pixelCoord, globalUniforms.frameIndex);

            float phase = mix(HenyeyGreenstein(cosTheta, -0.25), HenyeyGreenstein(cosTheta, 0.72), 0.72);
            vec3 sunIrradiance = globalUniforms.lightColor * globalUniforms.lightIntensity * sunTrans;
            vec3 zenithSkyNits = textureLod(skyViewLUT, DirToSkyViewUV(vec3(0.0, 1.0, 0.0)), 0.0).rgb;
            vec3 horizonSkyNits = textureLod(skyViewLUT, DirToSkyViewUV(normalize(vec3(rd.x, 0.05, rd.z))), 0.0).rgb;

            vec3 cloudInScatterNits = vec3(0.0);
            float cloudTransmittance = 1.0;
            float t = tEnter + jitter * stepSize;

            for (int i = 0; i < CLOUD_STEPS; ++i)
            {
                vec3 p = globalUniforms.cameraPosition + rd * t;
                float hFrac;
                float sigmaT = SampleCloudDensity(p, hFrac);

                if (sigmaT > 1e-6)
                {
                    float hDummy;
                    float shadowOpticalDepth = (
                        SampleCloudDensity(p + sunDir * 140.0, hDummy) * 140.0 +
                        SampleCloudDensity(p + sunDir * 420.0, hDummy) * 280.0
                    );

                    float beer = exp(-shadowOpticalDepth) + 0.32 * exp(-shadowOpticalDepth * 0.25);
                    float powder = 1.0 - 0.65 * exp(-sigmaT * 900.0 * 2.0);
                    float lightEnergy = clamp(beer * mix(1.0, powder, clamp(-cosTheta * 0.5 + 0.5, 0.0, 1.0)), 0.0, 1.35);

                    vec3 ambientCloudNits = mix(horizonSkyNits * 0.55, zenithSkyNits * 1.15, hFrac);
                    vec3 directCloudNits = sunIrradiance * phase * lightEnergy;
                    vec3 S = (directCloudNits + ambientCloudNits) * sigmaT;

                    float stepTrans = exp(-sigmaT * stepSize);
                    cloudInScatterNits += cloudTransmittance * (S - S * stepTrans) / max(sigmaT, 1e-6);
                    cloudTransmittance *= stepTrans;

                    if (cloudTransmittance < 0.02)
                        break;
                }

                t += stepSize;
            }

            float horizonFade = smoothstep(0.015, 0.16, rd.y) * exp(-tEnter * 0.000032);
            cloudTransmittance = mix(1.0, cloudTransmittance, horizonFade);
            cloudInScatterNits *= horizonFade;

            skyColor = skyColor * cloudTransmittance + cloudInScatterNits;
        }
    }

    vec3 preExposed = clamp(skyColor * globalUniforms.cameraExposure, vec3(0.0), vec3(65000.0));
    imageStore(outHdrColor, pixelCoord, vec4(preExposed, 1.0));
}
