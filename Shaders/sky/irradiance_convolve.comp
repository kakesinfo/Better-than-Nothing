#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D skyViewLUT;
layout(set = 1, binding = 1, rgba16f) writeonly uniform image2D outIrradiance;

const float PI = 3.14159265359;
const float PLANET_RADIUS_KM = 6360.0;

vec2 DirToSkyViewUV(vec3 dir)
{
    float viewHeight = PLANET_RADIUS_KM + 0.001;
    float vHorizon = sqrt(max(0.0, viewHeight * viewHeight - PLANET_RADIUS_KM * PLANET_RADIUS_KM));
    float cosBeta = vHorizon / viewHeight;
    float beta = acos(clamp(cosBeta, -1.0, 1.0));
    float zenithHorizonAngle = PI - beta;

    float viewZenithAngle = acos(clamp(dir.y, -1.0, 1.0));
    float v = 0.0;
    if (viewZenithAngle < zenithHorizonAngle)
    {
        float coord = 1.0 - viewZenithAngle / max(zenithHorizonAngle, 1e-5);
        v = 0.5 * (1.0 - sqrt(max(0.0, coord)));
    }
    else
    {
        float coord = (viewZenithAngle - zenithHorizonAngle) / max(beta, 1e-5);
        v = 0.5 + 0.5 * sqrt(max(0.0, coord));
    }

    float azimuth = atan(dir.z, dir.x);
    float u = azimuth / (2.0 * PI) + 0.5;
    return vec2(u, clamp(v, 0.0, 1.0));
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(outIrradiance);
    if (pixelCoord.x >= dims.x || pixelCoord.y >= dims.y)
        return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(dims);
    float phi = (uv.x * 2.0 - 1.0) * PI;
    float theta = uv.y * PI;

    vec3 N = normalize(vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi)));
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = cross(N, right);

    vec3 irradiance = vec3(0.0);
    const float sampleDeltaPhi = 0.15;
    const float sampleDeltaTheta = 0.15;
    float nrSamples = 0.0;

    for (float p = 0.0; p < 2.0 * PI; p += sampleDeltaPhi)
    {
        for (float t = 0.0; t < 0.5 * PI; t += sampleDeltaTheta)
        {
            vec3 tangentSample = vec3(sin(t) * cos(p), sin(t) * sin(p), cos(t));
            vec3 sampleVec = normalize(tangentSample.x * right + tangentSample.y * up + tangentSample.z * N);

            vec3 skySample = textureLod(skyViewLUT, DirToSkyViewUV(sampleVec), 0.0).rgb;
            irradiance += skySample * cos(t) * sin(t);
            nrSamples += 1.0;
        }
    }

    irradiance = PI * irradiance / max(nrSamples, 1.0);
    imageStore(outIrradiance, pixelCoord, vec4(irradiance, 1.0));
}
