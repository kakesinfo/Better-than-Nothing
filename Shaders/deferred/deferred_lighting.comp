#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct PointLightData {
    vec3 position;
    float radius;
    vec3 color;
    float luminousPowerLm;
};

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 projection;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float sunAngularRadius;

    vec3 lightColor;
    float sunIlluminanceLux;

    vec3 cameraPosition;
    float cameraExposure;

    uint pointLightCount;
    uint frameIndex;
    uint screenWidth;
    uint screenHeight;

    uint debugView;
    uint toneMapMode;
    uint flags;
    float taaBlendFactor;

    float skyLuminanceNits;
    float atmosphereAltitudeKm;
    float atmosphereMieAnisotropy;
    float atmosphereMultiScatteringFactor;

    float atmosphereDensityScale;
    float aoRadius;
    float aoPower;
    float irradianceIntensity;

    float time;
    float waterLevel;
    float waterWaveScale;
    float waterFoamIntensity;

    float grassWindStrength;
    float grassWindSpeed;
    float grassFadeDistance;
    float deltaTime;

    float cloudCoverage;
    float cloudDensity;
    float cloudSpeed;
    float cloudShadowStrength;
} globalUniforms;

layout(set = 1, binding = 0) uniform sampler2D gbufferAlbedoTex;
layout(set = 1, binding = 1) uniform sampler2D gbufferNormalTex;
layout(set = 1, binding = 2) uniform sampler2D gbufferMaterialTex;
layout(set = 1, binding = 3) uniform sampler2D gbufferMotionTex;
layout(set = 1, binding = 4) uniform sampler2D depthTex;

layout(std430, set = 1, binding = 5) readonly buffer PointLightBuffer {
    PointLightData lights[];
} pointLights;

layout(set = 1, binding = 6, rgba16f) writeonly uniform image2D outHdrColor;
layout(set = 1, binding = 7) uniform sampler2D rtShadowDenoisedTex;
layout(set = 1, binding = 8) uniform sampler2D sssTex;
layout(set = 1, binding = 9) uniform sampler2D aoDenoisedTex;
layout(set = 1, binding = 10) uniform sampler2D transmittanceLUT;
layout(set = 1, binding = 11) uniform sampler2D irradianceLUT;
layout(set = 1, binding = 12) uniform sampler2D prefilteredEnvLUT;
layout(set = 1, binding = 13) uniform sampler2D brdfLUT;

const float PI = 3.14159265359;
const float PLANET_RADIUS_KM = 6360.0;
const float ATMOSPHERE_RADIUS_KM = 6460.0;

vec3 DecodeOctahedral(vec2 e)
{
    vec3 v = vec3(e.xy, 1.0 - abs(e.x) - abs(e.y));
    if (v.z < 0.0)
    {
        vec2 s = vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
        v.xy = (1.0 - abs(v.yx)) * s;
    }
    return normalize(v);
}

vec3 ReconstructWorldPos(vec2 uv, float depth, mat4 invViewProj)
{
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = invViewProj * clipPos;
    return worldPos.xyz / max(abs(worldPos.w), 1e-6);
}

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / max(PI * denom * denom, 1e-6);
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / max(NdotV * (1.0 - k) + k, 1e-6);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return GeometrySchlickGGX(NdotV, roughness) * GeometrySchlickGGX(NdotL, roughness);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 EvaluatePBR(vec3 albedo, vec3 N, vec3 V, vec3 L, float metallic, float roughness, vec3 energyCompensation)
{
    vec3 H = normalize(V + L);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);

    float NDF = DistributionGGX(N, H, roughness);
    float G = GeometrySmith(N, V, L, roughness);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);

    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001;
    vec3 specular = (numerator / denominator) * energyCompensation;

    vec3 kS = F;
    vec3 kD = (vec3(1.0) - kS) * (1.0 - metallic);
    float NdotL = max(dot(N, L), 0.0);

    return (kD * albedo / PI + specular) * NdotL;
}

vec3 MultiBounceAO(float ao, vec3 albedo)
{
    vec3 a = 2.0404 * albedo - 0.3324;
    vec3 b = -4.7951 * albedo + 0.6417;
    vec3 c = 2.7552 * albedo + 0.6903;
    return max(vec3(ao), ((ao * a + b) * ao + c) * ao);
}

float ComputeSpecularAO(float NdotV, float ao, float roughness)
{
    return clamp(pow(NdotV + ao, exp2(-16.0 * roughness - 1.0)) - 1.0 + ao, 0.0, 1.0);
}

vec3 FresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 SampleSunTransmittance(float viewHeightKm, float cosZenith)
{
    float H = sqrt(max(0.0, ATMOSPHERE_RADIUS_KM * ATMOSPHERE_RADIUS_KM - PLANET_RADIUS_KM * PLANET_RADIUS_KM));
    float rho = sqrt(max(0.0, viewHeightKm * viewHeightKm - PLANET_RADIUS_KM * PLANET_RADIUS_KM));
    float disc = viewHeightKm * viewHeightKm * (cosZenith * cosZenith - 1.0) + ATMOSPHERE_RADIUS_KM * ATMOSPHERE_RADIUS_KM;
    float d = max(0.0, (-viewHeightKm * cosZenith + sqrt(max(0.0, disc))));
    float dMin = ATMOSPHERE_RADIUS_KM - viewHeightKm;
    float dMax = rho + H;
    float xMu = (d - dMin) / max(dMax - dMin, 1e-5);
    float xR = rho / max(H, 1e-5);
    return textureLod(transmittanceLUT, vec2(clamp(xMu, 0.0, 1.0), clamp(xR, 0.0, 1.0)), 0.0).rgb;
}

vec2 DirToEquirectUV(vec3 dir)
{
    float phi = atan(dir.z, dir.x);
    float theta = acos(clamp(dir.y, -1.0, 1.0));
    return vec2(phi / (2.0 * PI) + 0.5, theta / PI);
}

vec3 SampleIrradiance(vec3 N)
{
    return textureLod(irradianceLUT, DirToEquirectUV(N), 0.0).rgb;
}

vec3 SamplePrefilteredEnv(vec3 R, float roughness)
{
    vec2 eqUv = DirToEquirectUV(R);
    float band = clamp(roughness, 0.0, 1.0) * 4.0;
    float b0 = floor(band);
    float b1 = min(b0 + 1.0, 4.0);
    float frac = band - b0;

    float v0 = (b0 + clamp(eqUv.y, 0.01, 0.99)) / 5.0;
    float v1 = (b1 + clamp(eqUv.y, 0.01, 0.99)) / 5.0;

    vec3 c0 = textureLod(prefilteredEnvLUT, vec2(eqUv.x, v0), 0.0).rgb;
    vec3 c1 = textureLod(prefilteredEnvLUT, vec2(eqUv.x, v1), 0.0).rgb;
    return mix(c0, c1, frac);
}

float Hash31(vec3 p)
{
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float ValueNoise3D(vec3 x)
{
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(mix(Hash31(i + vec3(0, 0, 0)), Hash31(i + vec3(1, 0, 0)), f.x),
            mix(Hash31(i + vec3(0, 1, 0)), Hash31(i + vec3(1, 1, 0)), f.x), f.y),
        mix(mix(Hash31(i + vec3(0, 0, 1)), Hash31(i + vec3(1, 0, 1)), f.x),
            mix(Hash31(i + vec3(0, 1, 1)), Hash31(i + vec3(1, 1, 1)), f.x), f.y),
        f.z
    );
}

float SampleCloudShadowTransmittance(vec3 worldPos, vec3 sunDir, float time)
{
    if ((globalUniforms.flags & (1u << 6)) == 0u || sunDir.y <= 0.02 || globalUniforms.cloudShadowStrength <= 0.001)
        return 1.0;

    float tCloud = (1350.0 - worldPos.y) / max(sunDir.y, 0.05);
    if (tCloud <= 0.0)
        return 1.0;

    vec3 cloudPos = worldPos + sunDir * min(tCloud, 25000.0);
    vec3 wind = vec3(0.82, 0.0, 0.57) * (time * globalUniforms.cloudSpeed * 28.0);
    vec3 p = (cloudPos + wind) * 0.00034;
    float n0 = ValueNoise3D(p);
    float n1 = ValueNoise3D(p * 2.07 + vec3(13.7, 5.1, 9.3));
    float baseShape = n0 * 0.65 + n1 * 0.35;
    float coverageThreshold = 1.0 - clamp(globalUniforms.cloudCoverage, 0.0, 0.95);
    float cloudMask = smoothstep(coverageThreshold, min(coverageThreshold + 0.32, 0.99), baseShape);
    return 1.0 - cloudMask * clamp(globalUniforms.cloudShadowStrength * globalUniforms.cloudDensity, 0.0, 0.92);
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(outHdrColor);
    if (pixelCoord.x >= dims.x || pixelCoord.y >= dims.y)
        return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(dims);
    float depth = textureLod(depthTex, uv, 0.0).r;

    vec3 albedo = textureLod(gbufferAlbedoTex, uv, 0.0).rgb;
    vec2 encNormal = textureLod(gbufferNormalTex, uv, 0.0).rg;
    vec3 N = DecodeOctahedral(encNormal);
    vec4 matData = textureLod(gbufferMaterialTex, uv, 0.0);
    float metallic = matData.r;
    float roughness = matData.g;
    float ao = matData.b;
    vec2 motion = textureLod(gbufferMotionTex, uv, 0.0).rg;

    float shadowVisibility = ((globalUniforms.flags & (1u << 0)) != 0u) ? textureLod(rtShadowDenoisedTex, uv, 0.0).r : 1.0;
    float sssVisibility = ((globalUniforms.flags & (1u << 5)) != 0u) ? textureLod(sssTex, uv, 0.0).r : 1.0;
    float combinedShadow = min(shadowVisibility, sssVisibility);
    float aoSample = ((globalUniforms.flags & (1u << 4)) != 0u) ? textureLod(aoDenoisedTex, uv, 0.0).r : 1.0;
    float combinedAO = min(ao, aoSample);

    vec3 worldPos = (depth < 1.0) ? ReconstructWorldPos(uv, depth, globalUniforms.invViewProj) : vec3(0.0);
    vec3 sunL = normalize(-globalUniforms.lightDirection);
    float cloudTransmittance = (depth < 1.0) ? SampleCloudShadowTransmittance(worldPos, sunL, globalUniforms.time) : 1.0;
    vec3 diffuseIrradiance = SampleIrradiance(N) * globalUniforms.irradianceIntensity;

    uint dbg = globalUniforms.debugView;
    if (dbg >= 1u && dbg <= 11u)
    {
        vec3 debugOut = vec3(0.0);
        if (dbg == 1u)
            debugOut = albedo;
        else if (dbg == 2u)
            debugOut = N * 0.5 + 0.5;
        else if (dbg == 3u)
            debugOut = vec3(metallic);
        else if (dbg == 4u)
            debugOut = vec3(roughness);
        else if (dbg == 5u)
            debugOut = vec3(abs(motion) * 40.0, 0.0);
        else if (dbg == 6u)
            debugOut = vec3(shadowVisibility);
        else if (dbg == 7u)
            debugOut = vec3(combinedAO);
        else if (dbg == 8u)
            debugOut = clamp((diffuseIrradiance / PI) * globalUniforms.cameraExposure, vec3(0.0), vec3(1.0));
        else if (dbg == 9u)
            debugOut = vec3(pow(clamp(depth, 0.0, 1.0), 32.0));
        else if (dbg == 10u)
            debugOut = vec3(sssVisibility);
        else if (dbg == 11u)
            debugOut = vec3(cloudTransmittance);

        imageStore(outHdrColor, pixelCoord, vec4(debugOut, 1.0));
        return;
    }

    if (depth >= 1.0)
        return;

    vec3 V = normalize(globalUniforms.cameraPosition - worldPos);
    float NdotV = max(dot(N, V), 0.001);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);

    // Precomputed GGX BRDF integration LUT + Fdez-Aguera multi-scattering energy compensation
    vec2 brdf = textureLod(brdfLUT, vec2(NdotV, roughness), 0.0).rg;
    vec3 energyCompensation = 1.0 + F0 * (1.0 / max(brdf.x + brdf.y, 1e-4) - 1.0);

    // Directional Sun tinted by Hillaire atmospheric transmittance & volumetric cloud shadows
    float camAltKm = max(globalUniforms.atmosphereAltitudeKm + max(globalUniforms.cameraPosition.y * 0.001, 0.0), 0.005);
    float viewHeightKm = min(PLANET_RADIUS_KM + camAltKm, ATMOSPHERE_RADIUS_KM - 0.05);
    float sunHorizonFade = smoothstep(-0.04, 0.02, sunL.y);
    vec3 sunTrans = SampleSunTransmittance(viewHeightKm, sunL.y) * sunHorizonFade;
    vec3 sunRadiance = globalUniforms.lightColor * globalUniforms.sunIlluminanceLux * sunTrans * combinedShadow * cloudTransmittance;
    vec3 Lo = EvaluatePBR(albedo, N, V, sunL, metallic, roughness, energyCompensation) * sunRadiance;

    // Point Lights with Lagarde smooth distance attenuation
    for (uint i = 0u; i < globalUniforms.pointLightCount; ++i)
    {
        PointLightData light = pointLights.lights[i];
        vec3 toLight = light.position - worldPos;
        float dist = length(toLight);
        if (dist > light.radius || dist < 1e-5)
            continue;

        vec3 L = toLight / dist;
        float distRatio = dist / max(light.radius, 1e-4);
        float window = pow(clamp(1.0 - pow(distRatio, 4.0), 0.0, 1.0), 2.0);
        float attenuation = window / (dist * dist + 1.0);
        vec3 radiance = light.color * (light.luminousPowerLm / (4.0 * PI)) * attenuation;

        Lo += EvaluatePBR(albedo, N, V, L, metallic, roughness, energyCompensation) * radiance;
    }

    // Split-Sum IBL (irradianceLUT + prefilteredEnvLUT + brdfLUT) modulated by Multi-Bounce & Specular AO
    vec3 F = FresnelSchlickRoughness(NdotV, F0, roughness);
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);

    vec3 diffuseAO = MultiBounceAO(combinedAO, albedo);
    float specularAO = ComputeSpecularAO(NdotV, combinedAO, roughness);

    vec3 R = reflect(-V, N);
    vec3 prefilteredColor = SamplePrefilteredEnv(R, roughness) * globalUniforms.irradianceIntensity;

    // Suppress grazing IBL Fresnel on ultra-rough matte dielectrics (grass, sand, soil)
    float roughGrazingAtten = mix(1.0 - roughness * roughness, 1.0, metallic);
    vec3 ambientDiffuse = kD * (albedo / PI) * diffuseIrradiance * diffuseAO;
    vec3 ambientSpecular = prefilteredColor * (F0 * brdf.x + brdf.y * roughGrazingAtten) * energyCompensation * specularAO;
    vec3 ambient = ambientDiffuse + ambientSpecular;
    vec3 hdrLuminance = ambient + Lo;
    vec3 preExposedHdr = clamp(hdrLuminance * globalUniforms.cameraExposure, vec3(0.0), vec3(65000.0));

    imageStore(outHdrColor, pixelCoord, vec4(preExposedHdr, 1.0));
}
