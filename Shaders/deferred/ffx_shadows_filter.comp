#version 450

// AMD FidelityFX Shadow Denoiser (FFX_DNSR_Shadows) - Stage 2:
// Variance-Guided Edge-Stopping A-Trous Wavelet Soft Shadow Filter (3 passes: stepSize = 1, 2, 4)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float sunAngularRadius;

    vec3 lightColor;
    float sunIlluminanceLux;

    vec3 cameraPosition;
    float cameraExposure;

    uint pointLightsCount;
    uint frameIndex;
    uint screenWidth;
    uint screenHeight;

    uint debugView;
    uint toneMapMode;
    uint flags;
    float taaBlendFactor;

    float skyLuminanceNits;
    float atmosphereAltitudeKm;
    float atmosphereMieAnisotropy;
    float atmosphereMultiScatteringFactor;

    float atmosphereDensityScale;
    float aoRadius;
    float aoPower;
    float irradianceIntensity;
} globalUniforms;

layout(push_constant) uniform FilterPushConstants {
    int stepSize;
    float depthSigma;
    float normalSigma;
    float shadowPhi;
} push;

layout(std430, set = 1, binding = 0) readonly buffer ShadowTileMetaBuffer {
    uint tileMeta[];
} shadowTileMeta;
layout(set = 1, binding = 1) uniform sampler2D inShadowTex; // rg16f: mean, variance
layout(set = 1, binding = 2) uniform sampler2D depthTex;
layout(set = 1, binding = 3) uniform sampler2D gbufferNormalTex;
layout(set = 1, binding = 4, rg16f) uniform writeonly image2D outShadowTex;

const uint FLAG_SHADOW_DENOISER_ENABLED = 1u << 1;
const uint TILE_ALL_LIT = 1u;
const uint TILE_ALL_SHADOWED = 2u;

vec3 DecodeOctahedral(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(globalUniforms.screenWidth, globalUniforms.screenHeight);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 texelSize = 1.0 / vec2(size);
    vec2 uv = (vec2(pixel) + 0.5) * texelSize;
    vec2 centerShadow = textureLod(inShadowTex, uv, 0.0).rg;

    if ((globalUniforms.flags & FLAG_SHADOW_DENOISER_ENABLED) == 0u) {
        imageStore(outShadowTex, pixel, vec4(centerShadow, 0.0, 0.0));
        return;
    }

    // FFX Tile early-out: skip filtering on homogeneous fully-lit or fully-shadowed 8x4 tiles
    uint tilesX = (globalUniforms.screenWidth + 7u) / 8u;
    uint tileX = uint(pixel.x) / 8u;
    uint tileY = uint(pixel.y) / 4u;
    uint meta = shadowTileMeta.tileMeta[tileY * tilesX + tileX];
    if (meta == TILE_ALL_LIT) {
        imageStore(outShadowTex, pixel, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }
    if (meta == TILE_ALL_SHADOWED) {
        imageStore(outShadowTex, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    float centerDepth = textureLod(depthTex, uv, 0.0).r;
    if (centerDepth >= 1.0) {
        imageStore(outShadowTex, pixel, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    vec3 centerNormal = DecodeOctahedral(textureLod(gbufferNormalTex, uv, 0.0).rg);

    // Estimate 3x3 smoothed variance around center (FFX variance-guided edge stopping)
    float filteredVar = 0.0;
    const float varKernel[3] = float[3](0.25, 0.5, 0.25);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec2 sUV = clamp(uv + vec2(dx, dy) * texelSize, vec2(0.0), vec2(1.0));
            filteredVar += textureLod(inShadowTex, sUV, 0.0).g * varKernel[dx + 1] * varKernel[dy + 1];
        }
    }

    float sigmaShadow = push.shadowPhi * sqrt(max(filteredVar, 0.0)) + 1e-4;
    float depthThresh = max(centerDepth * push.depthSigma, 1e-4);

    // 3x3 A-Trous wavelet filter with stride = push.stepSize (1, 2, 4)
    const float kernel[3] = float[3](0.25, 0.5, 0.25);
    float sumMean = centerShadow.r;
    float sumVar = centerShadow.g;
    float sumWeight = 1.0;

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0)
                continue;

            vec2 sampleUV = uv + vec2(dx * push.stepSize, dy * push.stepSize) * texelSize;
            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0)
                continue;

            float sampleDepth = textureLod(depthTex, sampleUV, 0.0).r;
            if (sampleDepth >= 1.0)
                continue;

            vec3 sampleNormal = DecodeOctahedral(textureLod(gbufferNormalTex, sampleUV, 0.0).rg);
            vec2 sampleShadow = textureLod(inShadowTex, sampleUV, 0.0).rg;

            float wDepth = exp(-abs(sampleDepth - centerDepth) / depthThresh);
            float wNormal = pow(max(dot(centerNormal, sampleNormal), 0.0), push.normalSigma);
            float wShadow = exp(-abs(sampleShadow.r - centerShadow.r) / sigmaShadow);
            float wSpatial = kernel[dx + 1] * kernel[dy + 1];

            float w = wSpatial * wDepth * wNormal * wShadow;
            sumMean += sampleShadow.r * w;
            sumVar += sampleShadow.g * w * w;
            sumWeight += w;
        }
    }

    float outMean = sumMean / sumWeight;
    float outVar = sumVar / (sumWeight * sumWeight);
    imageStore(outShadowTex, pixel, vec4(clamp(outMean, 0.0, 1.0), max(outVar, 0.0), 0.0, 0.0));
}
