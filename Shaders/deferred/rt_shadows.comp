#version 460
#extension GL_EXT_ray_query : require

// Hardware Ray-Queried Soft Shadows + AMD FFX 8x4 Bitmask Tile Packing

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUniformBuffer {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 unjitteredViewProj;
    mat4 prevUnjitteredViewProj;

    vec3 lightDirection;
    float sunAngularRadius;

    vec3 lightColor;
    float sunIlluminanceLux;

    vec3 cameraPosition;
    float cameraExposure;

    uint pointLightsCount;
    uint frameIndex;
    uint screenWidth;
    uint screenHeight;

    uint debugView;
    uint toneMapMode;
    uint flags;
    float taaBlendFactor;

    float skyLuminanceNits;
    float atmosphereAltitudeKm;
    float atmosphereMieAnisotropy;
    float atmosphereMultiScatteringFactor;

    float atmosphereDensityScale;
    float aoRadius;
    float aoPower;
    float irradianceIntensity;
} globalUniforms;

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 1, binding = 1) uniform sampler2D depthTex;
layout(set = 1, binding = 2) uniform sampler2D gbufferNormalTex;
layout(set = 1, binding = 3, rg16f) uniform writeonly image2D outShadowRaw;
layout(std430, set = 1, binding = 4) writeonly buffer ShadowTileMaskBuffer {
    uint tileMasks[];
} shadowTileMask;

const uint FLAG_RT_SHADOWS_ENABLED = 1u << 0;
const uint FLAG_SHADOW_DENOISER_ENABLED = 1u << 1;

// Each 8x8 workgroup covers two 8x4 AMD FFX bitmask tiles (rows 0..3 and rows 4..7)
shared uint s_tileMask[2];

vec3 DecodeOctahedral(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

vec3 ReconstructWorldPos(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = globalUniforms.invViewProj * clipPos;
    return worldPos.xyz / worldPos.w;
}

float InterleavedGradientNoise(vec2 pixel, uint frame) {
    vec2 p = pixel + float(frame & 63u) * vec2(5.588238, 5.588238);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

uint PcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

vec2 SampleDisk(uvec2 pixel, uint frame) {
    float r1 = InterleavedGradientNoise(vec2(pixel), frame);
    uint h = PcgHash(pixel.x + pixel.y * 1973u + (frame & 63u) * 9277u);
    float r2 = float(h) * (1.0 / 4294967296.0);

    float radius = sqrt(r1);
    float theta = 6.28318530718 * r2;
    return vec2(radius * cos(theta), radius * sin(theta));
}

void BuildOrthonormalBasis(vec3 n, out vec3 tangent, out vec3 bitangent) {
    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(up, n));
    bitangent = cross(n, tangent);
}

void main() {
    if (gl_LocalInvocationIndex < 2u)
        s_tileMask[gl_LocalInvocationIndex] = 0u;
    barrier();

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    bool inBounds = (pixel.x < int(globalUniforms.screenWidth) && pixel.y < int(globalUniforms.screenHeight));

    float visibility = 1.0;

    if (inBounds && (globalUniforms.flags & FLAG_RT_SHADOWS_ENABLED) != 0u) {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(globalUniforms.screenWidth, globalUniforms.screenHeight);
        float depth = textureLod(depthTex, uv, 0.0).r;

        if (depth < 1.0) {
            vec3 worldPos = ReconstructWorldPos(uv, depth);
            vec3 N = DecodeOctahedral(textureLod(gbufferNormalTex, uv, 0.0).rg);
            vec3 L = normalize(-globalUniforms.lightDirection);

            if (dot(N, L) <= 0.0) {
                visibility = 0.0;
            } else {
                vec3 rayDir = L;
                float angularRadius = globalUniforms.sunAngularRadius;
                if (angularRadius > 0.0001) {
                    bool animateNoise = (globalUniforms.flags & FLAG_SHADOW_DENOISER_ENABLED) != 0u;
                    vec2 disk = SampleDisk(uvec2(pixel), animateNoise ? globalUniforms.frameIndex : 0u);
                    vec3 T, B;
                    BuildOrthonormalBasis(L, T, B);
                    rayDir = normalize(L + (T * disk.x + B * disk.y) * angularRadius);
                }

                float distToCam = length(globalUniforms.cameraPosition - worldPos);
                float normalBias = 0.004 + 0.0015 * distToCam;
                vec3 rayOrigin = worldPos + N * normalBias;

                rayQueryEXT rq;
                rayQueryInitializeEXT(
                    rq,
                    topLevelAS,
                    gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                    0xFF,
                    rayOrigin,
                    0.001,
                    rayDir,
                    1000.0
                );
                while (rayQueryProceedEXT(rq)) {}

                visibility = (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) ? 1.0 : 0.0;
            }
        }

        imageStore(outShadowRaw, pixel, vec4(visibility, 1.0, 0.0, 0.0));
    }

    // Pack 1-bit shadow hit mask into AMD FFX 8x4 tile bitmask (bit = 1 means lit)
    uint subTile = gl_LocalInvocationID.y >> 2u; // 0 for rows 0..3, 1 for rows 4..7
    uint bitIndex = (gl_LocalInvocationID.y & 3u) * 8u + gl_LocalInvocationID.x;
    if (visibility > 0.5)
        atomicOr(s_tileMask[subTile], 1u << bitIndex);

    barrier();

    if (gl_LocalInvocationIndex < 2u) {
        uint tilesX = (globalUniforms.screenWidth + 7u) / 8u;
        uint tilesY = (globalUniforms.screenHeight + 3u) / 4u;
        uint tileX = gl_WorkGroupID.x;
        uint tileY = gl_WorkGroupID.y * 2u + gl_LocalInvocationIndex;
        if (tileX < tilesX && tileY < tilesY)
            shadowTileMask.tileMasks[tileY * tilesX + tileX] = s_tileMask[gl_LocalInvocationIndex];
    }
}
