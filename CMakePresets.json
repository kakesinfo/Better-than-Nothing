{
	"version": 3,
	"configurePresets": [
		{
			"name": "ninja-debug",
			"displayName": "Debug",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/.build/debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "ninja-release",
			"displayName": "Release",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/.build/release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "ninja-debug",
			"configurePreset": "ninja-debug"
		},
		{
			"name": "ninja-release",
			"configurePreset": "ninja-release"
		}
	]
}
